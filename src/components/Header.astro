---
import site from '../data/site.json';
import { url } from '../lib/utils';

const path = Astro.url.pathname;
const isWriting = path === url('/') || path.startsWith(url('/writing/'));
const isAbout = path.startsWith(url('/about/'));
---

<header class="site-header">
  <a class="site-name" href={url('/')}>{site.name}</a>
  <nav aria-label="Main">
    <a href={url('/')} aria-current={isWriting ? 'page' : undefined}>Writing</a>
    <a href={url('/about/')} aria-current={isAbout ? 'page' : undefined}>About</a>
    <!-- Hidden until the script below runs, since it does nothing without JavaScript -->
    <button class="theme-toggle" type="button" hidden>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
  const paper = { light: '#f7f4ee', dark: '#1c1b19' };

  const current = () =>
    (root.dataset.theme as 'light' | 'dark' | undefined) ?? (systemDark.matches ? 'dark' : 'light');

  function update() {
    if (!button) return;
    const next = current() === 'dark' ? 'light' : 'dark';
    // Show the mode you'd switch to: a moon in light mode, a sun in dark mode
    button.dataset.next = next;
    button.setAttribute('aria-label', `Switch to ${next} mode`);
    button.title = `Switch to ${next} mode`;
    // Match the browser's toolbar colour to the chosen theme
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((meta) => meta.setAttribute('content', paper[current()]));
  }

  if (button) {
    button.hidden = false;
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      // Going back to what the system prefers forgets the choice,
      // so the site follows the system setting again.
      const systemTheme = systemDark.matches ? 'dark' : 'light';
      try {
        if (next === systemTheme) localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {}
      if (next === systemTheme) delete root.dataset.theme;
      else root.dataset.theme = next;
      update();
    });
    systemDark.addEventListener('change', update);
    update();
  }
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 2.25rem 0;
  }

  .site-name {
    font-family: var(--serif);
    font-size: 1.125rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.005em;
  }

  .site-name:hover {
    color: var(--accent);
  }

  nav {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    font-family: var(--sans);
    font-size: 0.875rem;
  }

  nav a,
  .theme-toggle {
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.25rem;
  }

  nav a:hover,
  .theme-toggle:hover {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  .theme-toggle {
    display: flex;
    align-self: center;
    /* a comfortable tap target without moving the icon */
    margin: -0.4rem -0.4rem -0.4rem 0;
    padding: 0.4rem;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .theme-toggle[hidden],
  .theme-toggle[data-next='dark'] .icon-sun,
  .theme-toggle[data-next='light'] .icon-moon {
    display: none;
  }

  .theme-toggle svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
