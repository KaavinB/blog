---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// The text of this page lives in src/content/pages/about.md
const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');

const { title, description, photo, photoAlt } = page.data;
const { Content } = await render(page);
---

<BaseLayout title={title} description={description} image={photo}>
  <h1>{title}</h1>

  {
    photo && (
      <Image class="photo" src={photo} alt={photoAlt} width={240} densities={[1, 2]} />
    )
  }

  <div class="prose">
    <Content />
  </div>
</BaseLayout>

<style>
  h1 {
    margin: 3.5rem 0 2rem;
    font-size: 1.85rem;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: -0.01em;
  }

  .photo {
    display: block;
    width: 10rem;
    height: auto;
    margin-bottom: 2rem;
    border-radius: 2px;
  }

  @media (min-width: 40em) {
    h1 {
      margin-top: 4.5rem;
      font-size: 2.35rem;
    }

    .photo {
      width: 12rem;
    }
  }
</style>
